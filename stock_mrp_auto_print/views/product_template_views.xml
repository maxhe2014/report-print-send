<odoo>
  <record id="view_product_template_form_zpl2" model="ir.ui.view">
    <field name="name">product.template.form.zpl2</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="printer_zpl2.view_product_template_form_zpl2_labels"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='zpl_labels']" position="attributes">
        <attribute name="invisible">type not in ('consu', 'product')</attribute>
      </xpath>
      <xpath expr="//page[@name='zpl_labels']" position="inside">
        <group name="stock_mrp_zpl_label_section" string="Stock/MRP Labels">
          <group name="zpl_product_label_group" string="Product Labels">
            <field name="zpl_label_template_id" string="Product ZPL Label" options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="zpl_copies_per_label" string="Product Copies"/>
          </group>
          <group name="zpl_lot_label_group" string="Lot/SN Labels">
            <field name="zpl_created_lot_label_id" string="Created Lot/SN ZPL Label" options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="zpl_created_lot_copies" string="Created Copies"/>
            <field name="zpl_done_lot_label_id" string="Done Lot/SN ZPL Label" options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="zpl_done_lot_copies" string="Done Copies"/>
            <field name="zpl_no_print"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
