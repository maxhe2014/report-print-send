<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_zpl_label_print" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.zpl.label.print</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_zpl_label_wizard" 
                        type="object" 
                        string="Print ZPL Labels" 
                        class="btn-primary"
                        groups="base.group_user"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_move_tree_inherit_zpl_label_print" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.zpl.label.print</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <button name="action_open_zpl_label_wizard" 
                        type="object" 
                        string="Print ZPL" 
                        icon="fa-print"
                        groups="base.group_user"/>
            </xpath>
        </field>
    </record>
</odoo>
