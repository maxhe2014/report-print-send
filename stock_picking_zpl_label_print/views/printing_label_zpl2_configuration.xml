<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for ZPL label printer configuration -->
    <record id="printing_label_zpl2_configuration_view_form" model="ir.ui.view">
        <field name="name">printing.label.zpl2.configuration.form</field>
        <field name="model">printing.label.zpl2.configuration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_copy" type="object" string="Copy" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="label_id" domain="[('active', '=', True)]" />
                        </group>
                        <group>
                            <field name="printer_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Tree view for ZPL label printer configuration -->
    <record id="printing_label_zpl2_configuration_view_tree" model="ir.ui.view">
        <field name="name">printing.label.zpl2.configuration.tree</field>
        <field name="model">printing.label.zpl2.configuration</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name" />
                <field name="user_id" />
                <field name="label_id" />
                <field name="printer_id" />
                <button name="action_delete" type="object" string="Delete" icon="fa-trash" confirm="Are you sure you want to delete this configuration?" />
            </tree>
        </field>
    </record>
    
    <!-- Search view for ZPL label printer configuration -->
    <record id="printing_label_zpl2_configuration_view_search" model="ir.ui.view">
        <field name="name">printing.label.zpl2.configuration.search</field>
        <field name="model">printing.label.zpl2.configuration</field>
        <field name="arch" type="xml">
            <search string="ZPL Label Configurations">
                <field name="name" />
                <field name="user_id" />
                <field name="label_id" />
                <field name="printer_id" />
            </search>
        </field>
    </record>
    
    <!-- Action for ZPL label printer configuration -->
    <record id="printing_label_zpl2_configuration_action" model="ir.actions.act_window">
        <field name="name">ZPL Label Printer Configurations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">printing.label.zpl2.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- Menu item under Printing menu -->
    <menuitem
        name="ZPL Label Configurations"
        sequence="30"
        id="printing_label_zpl2_configuration_menu"
        parent="base_report_to_printer.printing_menu"
        action="printing_label_zpl2_configuration_action"
    />
</odoo>
