<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_product_template_form_repair_auto_print" model="ir.ui.view">
    <field name="name">product.template.form.repair.auto.print</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="printer_zpl2.view_product_template_form_zpl2_labels"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='zpl_labels']" position="attributes">
        <attribute name="invisible">type not in ('consu', 'product')</attribute>
      </xpath>
      <xpath expr="//page[@name='zpl_labels']" position="inside">
        <group name="repair_zpl2_label_section" string="Repair Labels">
          <div class="text-muted" colspan="2">Leave a template empty to use the repair operation type default. Set copies to 0 to inherit its quantity.</div>
          <group name="repair_product_zpl2_label_group" string="Product Labels">
            <field name="repair_product_zpl2_label_id" options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="repair_product_zpl2_copies"/>
          </group>
          <group name="repair_lot_zpl2_label_group" string="Lot/SN Labels" groups="stock.group_production_lot">
            <field name="done_repair_lot_zpl2_label_id" options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="done_repair_lot_zpl2_copies"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
