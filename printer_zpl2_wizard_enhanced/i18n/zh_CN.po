#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,help:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__exact_copies
msgid ""
"Total number of labels to print when Quantity Mode is Exact Total Labels."
msgstr "数量计算方式为“精确指定总张数”时，实际打印的总张数。"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,field_description:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__use_lot_range
