#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,field_description:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__available_lot_ids
msgid "Available Lots/Serials"
msgstr "可选批次/序列号"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields.selection,name:printer_zpl2_wizard_enhanced.selection__wizard_print_record_label__quantity_source__per_quantity
msgid "By Product Quantity"
msgstr "按产品数量"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,help:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__quantity_source
msgid ""
"By Product Quantity: one label per unit of the product, multiplied by "
"copies. Per Record / Serial: a fixed number of labels for each record or "
"serial. Exact Total Labels: print exactly the total number you specify."
msgstr "按产品数量：每件产品一张，再乘以份数。按记录/序列号：每条记录或每个序列号打印固定张数。精确指定总张数：按你填写的总张数打印。"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,field_description:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__copies_per_label
msgid "Copies per Record / Serial"
msgstr "每单位/记录/序列号份数"

#. module: printer_zpl2_wizard_enhanced
#. odoo-python
#: code:addons/printer_zpl2_wizard_enhanced/wizard/wizard_print_record_label.py:0
#, python-format
msgid "Copies per label must be between 1 and 6."
msgstr "每张标签份数必须在 1 至 6 之间。"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,field_description:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__exact_copies
#: model:ir.model.fields.selection,name:printer_zpl2_wizard_enhanced.selection__wizard_print_record_label__quantity_source__exact
msgid "Exact Total Labels"
msgstr "精确指定总张数"

#. module: printer_zpl2_wizard_enhanced
#. odoo-python
#: code:addons/printer_zpl2_wizard_enhanced/wizard/wizard_print_record_label.py:0
#, python-format
msgid "Exact total labels must be between 1 and 999."
msgstr "精确总张数必须在 1 至 999 之间。"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,field_description:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__label_id
msgid "Label"
msgstr "标签"

#. module: printer_zpl2_wizard_enhanced
#. odoo-python
#: code:addons/printer_zpl2_wizard_enhanced/wizard/wizard_print_record_label.py:0
#, python-format
msgid "Label printing failed after %(printed)s label(s) were sent: %(error)s"
msgstr "已发送 %(printed)s 张标签后打印失败：%(error)s"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,help:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__label_id
msgid "Label to print."
msgstr "要打印的标签。"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,help:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__copies_per_label
msgid "Labels printed for each unit / record / serial, between 1 and 6."
msgstr "每个单位/记录/序列号打印的张数，范围 1 至 6。"

#. module: printer_zpl2_wizard_enhanced
#: model:ir.model.fields,field_description:printer_zpl2_wizard_enhanced.field_wizard_print_record_label__lot_ids
msgid "Lots/Serial Numbers"
msgstr "批次/序列号"

#. module: printer_zpl2_wizard_enhanced
#. odoo-python
#: code:addons/printer_zpl2_wizard_enhanced/wizard/wizard_print_record_label.py:0
