<odoo>

    <record id="view_picking_type_form_inherit_mrp_zpl2" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.mrp.zpl2</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="mrp.view_picking_type_form_inherit_mrp"/>
        <field name="arch" type="xml">

            <!-- Add custom ZPL II label selector for "Done" Lot/SN Labels -->
            <xpath
                expr="//field[@name='done_mrp_lot_label_to_print']/.."
                position="after"
            >
                <div
                    colspan="2"
                    groups="stock.group_production_lot"
                    invisible="not auto_print_done_mrp_lot"
                >
                    <div class="o_row">
                        <label for="done_mrp_lot_zpl2_label_id" string="Custom ZPL Label:" class="fw-bold" style="min-width: 120px;"/>
                        <field
                            name="done_mrp_lot_zpl2_label_id"
                            nolabel="1"
                            options="{'no_create': True, 'no_create_edit': True}"
                            style="flex: 1 1 auto;"
                        />
                    </div>
                    <div class="o_row">
                        <label for="done_mrp_lot_zpl2_copies" string="Copies:" class="fw-bold" style="min-width: 120px;"/>
                        <field name="done_mrp_lot_zpl2_copies" nolabel="1" style="flex: 1 1 auto;"/>
                    </div>
                </div>
            </xpath>

            <!-- Add custom ZPL II label selector for "Generated" Lot/SN Labels -->
            <xpath
                expr="//field[@name='generated_mrp_lot_label_to_print']/.."
                position="after"
            >
                <div
                    colspan="2"
                    groups="stock.group_production_lot"
                    invisible="not auto_print_generated_mrp_lot"
                >
                    <div class="o_row">
                        <label for="generated_mrp_lot_zpl2_label_id" string="Custom ZPL Label:" class="fw-bold" style="min-width: 120px;"/>
                        <field
                            name="generated_mrp_lot_zpl2_label_id"
                            nolabel="1"
                            options="{'no_create': True, 'no_create_edit': True}"
                            style="flex: 1 1 auto;"
                        />
                    </div>
                    <div class="o_row">
                        <label for="generated_mrp_lot_zpl2_copies" string="Copies:" class="fw-bold" style="min-width: 120px;"/>
                        <field name="generated_mrp_lot_zpl2_copies" nolabel="1" style="flex: 1 1 auto;"/>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
