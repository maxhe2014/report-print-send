<odoo>
    <record id="view_picking_type_form_zpl2" model="ir.ui.view">
        <field name="name">stock.picking.type.form.zpl2</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">

            <!-- Product Labels: hide standard IoT format selector, show ZPL label + copies inline -->
            <xpath expr="//field[@name='product_label_format']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='product_label_format']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_label_format']" position="after">
                <label for="product_zpl2_label_id" string="ZPL Label Template:" invisible="not auto_print_product_labels" class="fw-bold"/>
                <field
                    name="product_zpl2_label_id"
                    nolabel="1"
                    invisible="not auto_print_product_labels"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
                <label for="product_zpl2_copies" string="Copies:" invisible="not auto_print_product_labels" class="fw-bold"/>
                <field name="product_zpl2_copies" nolabel="1" invisible="not auto_print_product_labels"/>
            </xpath>

            <!-- Lot/SN Labels: hide standard IoT format selector, show ZPL label + copies inline -->
            <xpath expr="//field[@name='lot_label_format']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='lot_label_format']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_label_format']" position="after">
                <label for="lot_zpl2_label_id" string="ZPL Label Template:" invisible="not auto_print_lot_labels" class="fw-bold"/>
                <field
                    name="lot_zpl2_label_id"
                    nolabel="1"
                    invisible="not auto_print_lot_labels"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
                <label for="lot_zpl2_copies" string="Copies:" invisible="not auto_print_lot_labels" class="fw-bold"/>
                <field name="lot_zpl2_copies" nolabel="1" invisible="not auto_print_lot_labels"/>
            </xpath>

            <!-- Package Label: hide standard IoT format selector, show ZPL label + copies inline -->
            <xpath expr="//field[@name='package_label_to_print']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='package_label_to_print']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='package_label_to_print']" position="after">
                <label for="package_zpl2_label_id" string="ZPL Label Template:" invisible="not auto_print_package_label" class="fw-bold"/>
                <field
                    name="package_zpl2_label_id"
                    nolabel="1"
                    invisible="not auto_print_package_label"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
                <label for="package_zpl2_copies" string="Copies:" invisible="not auto_print_package_label" class="fw-bold"/>
                <field name="package_zpl2_copies" nolabel="1" invisible="not auto_print_package_label"/>
            </xpath>

        </field>
    </record>
</odoo>
