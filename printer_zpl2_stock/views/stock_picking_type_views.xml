<odoo>
    <record id="view_picking_type_form_zpl2" model="ir.ui.view">
        <field name="name">stock.picking.type.form.zpl2</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <!-- Add custom ZPL II label selector for Lot/SN Labels -->
            <xpath
                expr="//field[@name='lot_label_format']"
                position="after"
            >
                <label
                    for="lot_zpl2_label_id"
                    string="Custom ZPL Label:"
                    invisible="not auto_print_lot_labels"
                    class="fw-bold"
                />
                <field
                    name="lot_zpl2_label_id"
                    invisible="not auto_print_lot_labels"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
                <label
                    for="lot_zpl2_copies"
                    string="Copies:"
                    invisible="not auto_print_lot_labels"
                    class="fw-bold"
                />
                <field
                    name="lot_zpl2_copies"
                    invisible="not auto_print_lot_labels"
                />
            </xpath>

            <!-- Add custom ZPL II label selector for Package Label -->
            <xpath
                expr="//field[@name='package_label_to_print']"
                position="after"
            >
                <label
                    for="package_zpl2_label_id"
                    string="Custom ZPL Label:"
                    invisible="not auto_print_package_label"
                    class="fw-bold"
                />
                <field
                    name="package_zpl2_label_id"
                    invisible="not auto_print_package_label"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
                <label
                    for="package_zpl2_copies"
                    string="Copies:"
                    invisible="not auto_print_package_label"
                    class="fw-bold"
                />
                <field
                    name="package_zpl2_copies"
                    invisible="not auto_print_package_label"
                />
            </xpath>
        </field>
    </record>
</odoo>
