<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 打印向导表单视图 -->
        <record id="view_print_zpl_label_wizard_form" model="ir.ui.view">
            <field name="name">print.zpl.label.wizard.form</field>
            <field name="model">print.zpl.label.wizard</field>
            <field name="arch" type="xml">
                <form string="打印ZPL标签">
                    <sheet>
                        <group>
                            <group string="打印设置">
                                <field name="printer_id" widget="selection" required="1"/>
                                <field name="label_template_id" widget="selection" required="1"/>
                                <field name="copies_per_label"/>
                            </group>
                            <group string="打印对象">
                                <field name="lot_ids" widget="many2many_tags" nolabel="1" required="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_print_labels" 
                                string="打印标签" 
                                type="object" 
                                class="btn-primary"/>
                        <button name="action_test_print" 
                                string="测试打印" 
                                type="object" 
                                class="btn-secondary"/>
                        <button string="取消" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- 打印向导动作 -->
        <record id="action_print_zpl_label_wizard" model="ir.actions.act_window">
            <field name="name">打印ZPL标签</field>
            <field name="res_model">print.zpl.label.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_print_zpl_label_wizard_form"/>
        </record>
    </data>
</odoo>