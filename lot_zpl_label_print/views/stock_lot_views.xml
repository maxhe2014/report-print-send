<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 在批次/序列号表单视图中添加打印按钮 -->
        <record id="view_stock_lot_form_inherit_zpl_print" model="ir.ui.view">
            <field name="name">stock.lot.form.inherit.zpl.print</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_print_default_zpl_label" 
                            type="object" 
                            string="打印ZPL标签" 
                            class="btn-primary"
                            groups="base.group_user"/>
                    <button name="action_open_print_zpl_label_wizard" 
                            type="object" 
                            string="选择模板打印" 
                            class="btn-secondary"
                            groups="base.group_user"/>
                </xpath>
            </field>
        </record>
        
        <!-- 在批次/序列号列表视图中添加批量打印按钮 -->
        <record id="view_stock_lot_tree_inherit_zpl_print" model="ir.ui.view">
            <field name="name">stock.lot.tree.inherit.zpl.print</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="editable">bottom</attribute>
                </xpath>
                <field name="name" position="after">
                    <button name="action_print_default_zpl_label" 
                            type="object" 
                            string="打印ZPL标签" 
                            class="btn-primary o_list_button"
                            groups="base.group_user"/>
                </field>
            </field>
        </record>
        
        <!-- 在更多操作菜单中添加打印选项 -->
        <record id="view_stock_lot_form_inherit_zpl_print_menu" model="ir.ui.view">
            <field name="name">stock.lot.form.inherit.zpl.print.menu</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_print_default_zpl_label" 
                            type="object" 
                            string="打印ZPL标签" 
                            class="oe_stat_button"
                            icon="fa-print"
                            groups="base.group_user">
                        <field name="name" widget="statinfo" string="打印标签"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>