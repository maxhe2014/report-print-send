<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ZPL标签打印向导表单视图 -->
        <record id="view_print_zpl_label_wizard_form" model="ir.ui.view">
            <field name="name">print.zpl.label.wizard.form</field>
            <field name="model">print.zpl.label.wizard</field>
            <field name="arch" type="xml">
                <form string="ZPL标签打印">
                    <sheet>
                        <group>
                            <group string="打印设置">
                                <field name="printer_id" widget="many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="label_template_id" widget="many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="copies_per_label"/>
                            </group>
                            <group string="批次选择">
                                <field name="lot_ids" widget="many2many_tags" nolabel="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_test_print" string="测试打印" type="object" class="btn-secondary"/>
                        <button name="action_print_labels" string="打印标签" type="object" class="btn-primary"/>
                        <button string="取消" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- ZPL标签打印向导动作 -->
        <record id="action_print_zpl_label_wizard" model="ir.actions.act_window">
            <field name="name">ZPL标签打印</field>
            <field name="res_model">print.zpl.label.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_print_zpl_label_wizard_form"/>
            <field name="context">{'active_ids': active_ids}</field>
        </record>
    </data>
</odoo>