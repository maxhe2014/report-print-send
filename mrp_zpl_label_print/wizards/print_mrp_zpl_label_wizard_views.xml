<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="print_mrp_zpl_label_wizard_form" model="ir.ui.view">
            <field name="name">print.mrp.zpl.label.wizard.form</field>
            <field name="model">print.mrp.zpl.label.wizard</field>
            <field name="arch" type="xml">
                <form string="Print ZPL Labels for Manufacturing Order">
                    <sheet>
                        <group>
                            <group string="Manufacturing Order">
                                <field name="production_id" readonly="1"/>
                            </group>
                            <group string="Print Settings">
                                <field name="printer_id" required="1" domain="[('id', 'in', available_printer_ids)]"/>
                                <field name="label_template_id" required="1"/>
                                <field name="copies_per_label"/>
                            </group>
                        </group>
                        <group string="Lots/Serials to Print">
                            <field name="lot_ids" widget="many2many_tags" nolabel="1" domain="[('id', 'in', available_lot_ids)]"/>
                        </group>
                        <!-- Hidden fields for domain computation -->
                        <field name="available_printer_ids" invisible="1"/>
                        <field name="available_lot_ids" invisible="1"/>
                    </sheet>
                    <footer>
                        <button name="action_test_print" string="Test Print" type="object" class="btn-secondary"/>
                        <button name="action_print_labels" string="Print Labels" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- Action to open the wizard -->
        <record id="action_print_mrp_zpl_label_wizard" model="ir.actions.act_window">
            <field name="name">Print ZPL Labels</field>
            <field name="res_model">print.mrp.zpl.label.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="print_mrp_zpl_label_wizard_form"/>
        </record>
    </data>
</odoo>