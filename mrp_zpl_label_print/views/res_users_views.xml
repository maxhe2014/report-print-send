<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend user form view, add default ZPL printer field -->
    <record model="ir.ui.view" id="view_users_form">
        <field name="name">res.users.form (in mrp_zpl_label_print)</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <group name="preferences" position="after">
                <group string="ZPL Label Printing" name="zpl_printing">
                    <field name="zpl_printer_id" string="Default ZPL Printer" options="{'no_create': True}" />
                </group>
            </group>
        </field>
    </record>
    
    <!-- Extend simplified user form view -->
    <record model="ir.ui.view" id="view_users_form_simple_modif">
        <field name="name">res.users.form.simple (in mrp_zpl_label_print)</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <group name="preferences" position="inside">
                <group name="zpl_printing">
                    <field name="zpl_printer_id" string="Default ZPL Printer" readonly="0" options="{'no_create': True}" />
                </group>
            </group>
        </field>
    </record>
</odoo>