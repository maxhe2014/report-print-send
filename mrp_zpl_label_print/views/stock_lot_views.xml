<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_zpl_label_print" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.zpl.label.print</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_print_default_zpl_label" 
                        type="object" 
                        string="快速打印标签" 
                        class="btn-primary"
                        groups="base.group_user"/>
                <button name="action_open_print_zpl_label_wizard" 
                        type="object" 
                        string="选择模板打印" 
                        class="btn-secondary"
                        groups="base.group_user"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_stock_lot_tree_inherit_zpl_label_print" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.zpl.label.print</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>
            <field name="name" position="after">
                <button name="action_print_default_zpl_label" 
                        type="object" 
                        string="打印标签" 
                        class="btn-primary"
                        groups="base.group_user"/>
            </field>
        </field>
    </record>
</odoo>