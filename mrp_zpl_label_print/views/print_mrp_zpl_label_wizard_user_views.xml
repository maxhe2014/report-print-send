<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_print_mrp_zpl_label_wizard_user_tree" model="ir.ui.view">
            <field name="name">print.mrp.zpl.label.wizard.user.tree</field>
            <field name="model">print.mrp.zpl.label.wizard.user</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="user_id"/>
                    <field name="active"/>
                    <field name="label_template_id"/>
                    <field name="printer_id"/>
                    <field name="copies_per_label"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_print_mrp_zpl_label_wizard_user_form" model="ir.ui.view">
            <field name="name">print.mrp.zpl.label.wizard.user.form</field>
            <field name="model">print.mrp.zpl.label.wizard.user</field>
            <field name="arch" type="xml">
                <form string="User Default ZPL Label Printing Configuration">
                    <sheet>
                        <group>
                            <group string="User Configuration">
                                <field name="user_id" required="1"/>
                                <field name="active"/>
                            </group>
                            <group string="Default Printing Settings">
                                <field name="label_template_id" domain="[('model_id.model', '=', 'stock.lot')]"/>
                                <field name="printer_id" domain="[('active', '=', True)]"/>
                                <field name="copies_per_label"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Action to open the user configuration -->
        <record id="action_print_mrp_zpl_label_wizard_user" model="ir.actions.act_window">
            <field name="name">User ZPL Label Printing Configurations</field>
            <field name="res_model">print.mrp.zpl.label.wizard.user</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure default ZPL label printing settings for users.
                </p>
                <p>
                    When a user clicks the "Produce" button on a manufacturing order,
                    the system will automatically print labels using their default configuration.
                </p>
            </field>
        </record>
        
        <!-- Menu Item -->
        <menuitem id="menu_print_mrp_zpl_label_wizard_user"
                  name="User ZPL Label Configurations"
                  parent="mrp.menu_mrp_config"
                  action="action_print_mrp_zpl_label_wizard_user"
                  sequence="100"
                  groups="base.group_user"/>
    </data>
</odoo>