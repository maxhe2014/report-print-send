<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_print_mrp_zpl_label_wizard_user_tree" model="ir.ui.view">
            <field name="name">print.mrp.zpl.label.wizard.user.tree</field>
            <field name="model">print.mrp.zpl.label.wizard.user</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="user_id"/>
                    <field name="active"/>
                    <field name="printer_id"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_print_mrp_zpl_label_wizard_user_form" model="ir.ui.view">
            <field name="name">print.mrp.zpl.label.wizard.user.form</field>
            <field name="model">print.mrp.zpl.label.wizard.user</field>
            <field name="arch" type="xml">
                <form string="User ZPL Label Printer Configuration">
                    <sheet>
                        <group>
                            <group string="User Configuration" name="user_configuration">
                                <field name="user_id" required="1"/>
                                <field name="active"/>
                            </group>
                            <group string="Printer Settings" name="printer_settings">
                                <field name="printer_id" domain="[('active', '=', True)]"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Action to open the user configuration -->
        <record id="action_print_mrp_zpl_label_wizard_user" model="ir.actions.act_window">
            <field name="name">User ZPL Label Printer Configurations</field>
            <field name="res_model">print.mrp.zpl.label.wizard.user</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure ZPL label printer settings for users.
                </p>
                <p>
                    When a user completes a manufacturing order, 
                    the system will automatically print ZPL labels using their default printer.
                </p>
            </field>
        </record>
        
        <!-- Menu Item -->
        <menuitem id="menu_print_mrp_zpl_label_wizard_user"
                  name="User ZPL Label Configurations"
                  parent="base_report_to_printer.printing_menu"
                  action="action_print_mrp_zpl_label_wizard_user"
                  sequence="100"
                  groups="base.group_user"/>
    </data>
</odoo>