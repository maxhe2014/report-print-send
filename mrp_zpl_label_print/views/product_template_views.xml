<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit product.template form view to add ZPL configuration fields -->
        <record id="view_product_template_form_inherit_zpl_config" model="ir.ui.view">
            <field name="name">product.template.form.inherit.zpl.config</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']/group" position="inside">
                    <group string="ZPL Label Configuration" name="zpl_label_config" invisible="type != 'product'">
                        <field name="zpl_label_template_id" widget="many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="zpl_copies_per_label"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>