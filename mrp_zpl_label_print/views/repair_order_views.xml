<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend repair order form view, add ZPL label print button -->
        <record id="view_repair_order_form_inherit_zpl" model="ir.ui.view">
            <field name="name">repair.order.form.inherit.zpl</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form" />
            <field name="arch" type="xml">
                <!-- Add ZPL label print button in button area -->
                <xpath expr="//header" position="inside">
                    <button name="action_open_repair_zpl_label_wizard" 
                            string="Print ZPL Label" 
                            type="object" 
                            class="btn-primary"
                            groups="base.group_user"/>
                </xpath>
                
                <!-- Add condition on repair completion button, decide whether to display based on user configuration -->
                <xpath expr="//button[@name='action_repair_end']" position="attributes">
                    <attribute name="invisible">state != 'under_repair'</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>